# Server Configuration
NODE_ENV=development
PORT=5000

# Frontend Origin(s) - Comma separated for multiple origins (e.g. https://myapp.vercel.app,http://localhost:5173)
FRONTEND_URL=http://localhost:5173

# Database Connection (PostgreSQL for Supabase / Neon Free Tier)
# Example Supabase/Neon: postgresql://user:password@ep-xyz.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/secure_ecommerce?schema=public"

# JWT Secrets (Generate strong 64-byte hex secrets: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))")
JWT_SECRET="replace_with_a_strong_64_byte_hex_secret_for_access_tokens_in_production"
JWT_REFRESH_SECRET="replace_with_a_different_strong_64_byte_hex_secret_for_refresh_tokens"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Initial Admin Seed Credentials (Used by prisma/seed.js)
SEED_ADMIN_EMAIL="admin@securestore.com"
SEED_ADMIN_PASSWORD="Admin@Secure2026!"

